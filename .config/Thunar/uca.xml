<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1788286385195179-1</unique-id>
	<command>exo-open --working-directory %f --launch TerminalEmulator</command>
	<description>Example for a custom action</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Set as Wallpaper &amp; Theme</name>
	<submenu></submenu>
	<unique-id>1788286385195179-2</unique-id>
	<command>bash -c &quot;~/.config/hypr/scripts/wall.sh %f&quot;</command>
	<description>Set selected image as wallpaper and extract system theme</description>
	<range></range>
	<patterns>*.png;*.jpg;*.jpeg;*.webp;*.bmp;*.PNG;*.JPG;*.JPEG;*.WEBP;*.BMP</patterns>
	<image-files/>
</action>
</actions>
