        id: img
        anchors.fill: parent
        source: "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='" + root.svgHex + "'><path d='" + root.pathData + "'/></svg>"
