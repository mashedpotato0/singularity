    readonly property string svgHex: {
        let c = root.color;
        let r = Math.round(c.r * 255).toString(16).padStart(2, '0');
        let g = Math.round(c.g * 255).toString(16).padStart(2, '0');
        let b = Math.round(c.b * 255).toString(16).padStart(2, '0');
        return "%23" + r + g + b;
    }

